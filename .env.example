# Spotify developer app (https://developer.spotify.com/dashboard)
# Redirect URI must be registered exactly: http://127.0.0.1:8080/
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# GetSongBPM key (free, https://getsongbpm.com/api) - fallback BPM/key source for tracks ReccoBeats lacks.
# GetSongBPM asks for a backlink to getsongbpm.com if you publish anything built on its data.
GETSONGBPM_API_KEY=
# Deezer login cookie (browser dev tools > Application > Cookies > deezer.com > arl).
# Used to create playlists without a developer app (unofficial). Treat like a password.
DEEZER_ARL=
# Optional, only if you have a Deezer developer app
# Deezer developer app (https://developers.deezer.com/myapps)
# App "redirect URL after authentication" must match: http://127.0.0.1:8081/callback
DEEZER_APP_ID=
DEEZER_APP_SECRET=
DEEZER_REDIRECT_URI=http://127.0.0.1:8081/callback
